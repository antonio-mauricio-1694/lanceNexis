<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
	<persistence-unit name="lanceNexis" transaction-type="RESOURCE_LOCAL">
	
	   <!-- Provider -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
         

        <!-- ENTIDADES (adicione suas classes aqui) -->
        <!-- Exemplo -->
        <!-- <class>com.seuprojeto.model.Usuario</class> -->

        <properties>

            <!-- JDBC -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/lanceNexisdb"/>
            <property name="javax.persistence.jdbc.user" value="mauricio"/>
            <property name="javax.persistence.jdbc.password" value="1604"/>

            <!-- Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Criar/atualizar schema -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- opções: create | create-drop | update | validate -->

            <!-- Logs SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Charset -->
            <property name="hibernate.connection.charSet" value="UTF-8"/>

        </properties>
	
	
	</persistence-unit>
</persistence>
